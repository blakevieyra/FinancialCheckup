# Local development — copy to .env in this directory (repo root).
# The API loads this file via server/index.js (../.env).

NODE_ENV=development
PORT=3001

# Required for full local smoke + stress (npm run pre-release in server/)
# Postgres connection string, e.g. from Render, Neon, or local Docker:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/financialcheckup

# Auth — use any long random string locally
JWT_SECRET=change-me-local-dev-secret

# Vite dev server origin (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Optional — same as server/.env.example for email, Stripe, AI, etc.

# Financial Checkup API — production template (set in Render dashboard, never commit real values)

NODE_ENV=production
PORT=3001

# Auth (Render: generateValue)
JWT_SECRET=

# Postgres (Render: fromDatabase connectionString)
# Required locally for npm run smoke / npm run stress / npm run pre-release
DATABASE_URL=

# Comma-separated allowed web origins, e.g. https://financialcheckup-web.onrender.com
CLIENT_URL=

# Public API URL for emails/links (optional if same host as CLIENT_URL)
API_PUBLIC_URL=

# Email — SendGrid (required for OTP registration in production)
SENDGRID_API_KEY=
MAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=info@operone2i.com

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_TRIAL_OFFER=
STRIPE_PRICE_TRIAL_WEEKLY=
STRIPE_TRIAL_DAYS=7

# AI (optional — Pro features degrade gracefully)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# SMS digests (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Weekly digest cron
WEEKLY_DIGEST_TZ=America/Los_Angeles
WEEKLY_DIGEST_CRON=0 9 * * *
# WEEKLY_DIGEST_CRON_DISABLED=1

# Internal admin digest trigger
ADMIN_DIGEST_SECRET=

# Database pool (optional — default 10)
# PG_POOL_MAX=10

# Macro context (optional)
FRED_API_KEY=
